{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spinarium-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  // Local preparation only. No production route, domain, or account is bound.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "AUTH_ENABLED": "false",
    "SIGNUP_ENABLED": "false",
    "APP_ORIGIN": "",
    "OIDC_ISSUER": "",
    "OIDC_CLIENT_ID": "",
    "AUTH0_CONNECTION": ""
  },
  "secrets": { "required": ["OIDC_CLIENT_SECRET"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "spinarium-local",
    // Sentinel for local simulation; replace only in a separate staging config.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "ARTWORK", "bucket_name": "spinarium-local-artwork" }],
  // Automatic request logs would capture OAuth callback query credentials.
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } }
}
